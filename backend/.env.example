# DocuCraft Backend — Environment Variables
# Copy this file to .env and fill in your real values:
#   cp .env.example .env

# Required: Groq API key — get free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Required: JWT secret key — generate with: openssl rand -hex 32
SECRET_KEY=your_long_random_secret_key_here

# Optional: PostgreSQL connection URL (Neon, Supabase, etc.)
# If not set, app falls back to SQLite (data resets on container restart)
DATABASE_URL=postgresql://user:password@host/dbname

# Optional: token expiry in minutes (default: 30)
# ACCESS_TOKEN_EXPIRE_MINUTES=30
